{
  "name": "workspace-harness-kit",
  "version": "0.2.0",
  "description": "Workspace discovery and deterministic release evidence for Agent Skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./onboarding": {
      "types": "./dist/types/adapters/onboarding.d.ts",
      "import": "./dist/onboarding.js"
    },
    "./harness": {
      "types": "./dist/types/adapters/harness.d.ts",
      "import": "./dist/harness.js"
    },
    "./harness-check": {
      "types": "./dist/types/adapters/harness-check.d.ts",
      "import": "./dist/harness-check.js"
    },
    "./harness-doctor": {
      "types": "./dist/types/adapters/harness-doctor.d.ts",
      "import": "./dist/harness-doctor.js"
    },
    "./harness-impact": {
      "types": "./dist/types/adapters/harness-impact.d.ts",
      "import": "./dist/harness-impact.js"
    },
    "./readiness": {
      "types": "./dist/types/adapters/readiness.d.ts",
      "import": "./dist/readiness.js"
    },
    "./workspace": {
      "types": "./dist/types/adapters/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./collect": {
      "types": "./dist/types/adapters/collect.d.ts",
      "import": "./dist/collect.js"
    },
    "./install": {
      "types": "./dist/types/adapters/install.d.ts",
      "import": "./dist/install.js"
    }
  },
  "bin": {
    "whk": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "scripts/install.mjs",
    "VERSION",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "src",
    "evals",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "check:types": "tsc --noEmit",
    "check:bundles": "node scripts/build.mjs --check",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check:examples": "python3 examples/check.py",
    "check:evals": "node evals/run.mjs check-fixtures",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.12.0",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2"
  }
}
